{
  "mcpServers": {
    "钉钉文档": {
      "type": "streamable-http",
      "url": "https://mcp-gw.dingtalk.com/server/<YOUR_HASH>?key=<YOUR_KEY>"
    },
    "钉钉表格": {
      "type": "streamable-http",
      "url": "https://mcp-gw.dingtalk.com/server/<YOUR_HASH>?key=<YOUR_KEY>"
    },
    "钉钉文档互动服务": {
      "type": "streamable-http",
      "url": "https://mcp-gw.dingtalk.com/server/<YOUR_HASH>?key=<YOUR_KEY>"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_PAT>"
      }
    }
  }
}
